default_shell "zsh"

keybinds clear-defaults=true {
    normal {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Alt n" { NewPane; }
        bind "Alt t" { NewTab; }
        bind "Alt x" { CloseFocus; }
        bind "Alt q" { Quit; }
        
        // Pure pane movement
        bind "Alt h" "Alt Left" { MoveFocus "Left"; }
        bind "Alt l" "Alt Right" { MoveFocus "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }

        // Dedicated tab switching
        bind "Alt Shift Left" "Alt Shift H" { GoToPreviousTab; }
        bind "Alt Shift Right" "Alt Shift L" { GoToNextTab; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }

        // Fixed scroll mode trigger
        bind "Alt s" { SwitchToMode "scroll"; }
    }

scroll {
        bind "Ctrl g" { SwitchToMode "normal"; }
        bind "Alt s" { SwitchToMode "normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        
        // Search triggers
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "s" { SwitchToMode "search"; }
        
        // Open scrollback in Neovim for Vim yanking
        bind "e" { EditScrollback; SwitchToMode "normal"; }
        
        bind "Esc" "Enter" "q" { SwitchToMode "normal"; }
    }

    entersearch {
        bind "Ctrl g" { SwitchToMode "normal"; }
        bind "Esc" { SwitchToMode "scroll"; }
        bind "Enter" { SwitchToMode "search"; }
    }

    search {
        bind "Ctrl g" { SwitchToMode "normal"; }
        bind "Esc" { SwitchToMode "scroll"; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "WholeWord"; }
        bind "r" { SearchToggleOption "Wrap"; }
    }

    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }
}

// Plugin aliases
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen false
    }

    zjstatus-hints location="https://github.com/b0o/zjstatus-hints/releases/latest/download/zjstatus-hints.wasm" {
        max_length 0
        pipe_name "zjstatus_hints"
        hide_in_base_mode false
    }
}

load_plugins {
    zellij:link
    zjstatus-hints
}

web_client {
    font "monospace"
}

theme "noctalia"
default_layout "default"
pane_frames true
pane_frame_style "full"
copy_command "wl-copy"
styled_underlines true
support_kitty_keyboard_protocol true
support_kitty_graphics_protocol true
show_startup_tips false
host_notification_protocol "osc99"
